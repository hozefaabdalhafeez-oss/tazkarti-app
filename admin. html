<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لوحة الأدمن - تذكرتي</title>

<style>
body{ font-family:Arial,sans-serif; background:#f5f7fa; margin:0; }
header{ background:#0d6efd; color:white; text-align:center; padding:20px; }
.container{ max-width:500px; margin:20px auto; padding:0 15px; }
.booking{ background:white; border-radius:12px; padding:15px; margin-bottom:15px; box-shadow:0 3px 8px #ddd; }
.item{ margin:6px 0; font-size:15px; }
.status{ font-weight:bold; padding:6px 10px; border-radius:8px; display:inline-block; margin-top:8px; }
.pending{ background:#fff3cd; color:#856404; }
.confirmed{ background:#d1e7dd; color:#0f5132; }
.cancelled{ background:#f8d7da; color:#842029; }
.btns{ display:flex; gap:8px; margin-top:10px; }
button{ flex:1; padding:10px; border:none; border-radius:8px; font-size:14px; cursor:pointer; color:white; }
.confirm-btn{ background:#198754; }
.cancel-btn{ background:#dc3545; }
.empty{ text-align:center; color:#777; padding:40px 10px; }
</style>
</head>

<body>

<header><h1>📋 لوحة الحجوزات</h1></header>

<div class="container" id="bookingsList"></div>

<script>

function loadBookings(){
    let bookings = JSON.parse(localStorage.getItem("bookings")) || [];
    let container = document.getElementById("bookingsList");

    if(bookings.length === 0){
        container.innerHTML = `<p class="empty">لا توجد حجوزات محفوظة حاليًا</p>`;
        return;
    }

    container.innerHTML = "";

    bookings.slice().reverse().forEach(b => {
        let statusClass = b.status === "مؤكد" ? "confirmed" : b.status === "ملغي" ? "cancelled" : "pending";

        container.innerHTML += `
            <div class="booking">
                <div class="item">🚌 ${b.company} — ${b.trip}</div>
                <div class="item">💺 مقعد: ${b.seat}</div>
                <div class="item">👤 ${b.name} — 📞 ${b.phone}</div>
                <div class="item">💰 ${b.price} | 🧾 ${b.transaction}</div>
                <div class="item">🕒 ${b.date}</div>
                <span class="status ${statusClass}">${b.status}</span>
                <div class="btns">
                    <button class="confirm-btn" onclick="updateStatus(${b.id}, 'مؤكد')">✅ تأكيد</button>
                    <button class="cancel-btn" onclick="updateStatus(${b.id}, 'ملغي')">❌ إلغاء</button>
                </div>
            </div>`;
    });
}

function updateStatus(id, newStatus){
    let bookings = JSON.parse(localStorage.getItem("bookings")) || [];
    bookings = bookings.map(b => b.id === id ? {...b, status:newStatus} : b);
    localStorage.setItem("bookings", JSON.stringify(bookings));
    loadBookings();
}

loadBookings();

</script>

</body>
</html>
